# Production releases and store listings, run by .github/workflows/promote.yml
# (see docs/RELEASING.md), plus the screenshot lanes used by
# update-store-screenshots.yml. Test builds do not use fastlane: they go out
# through .github/workflows/release.yml.
#
# Promotion never builds anything. It sends the build testers already have
# (the same build number on both stores) to production, so what ships is what
# was tested.

opt_out_usage

default_platform(:ios)

# Lane code runs inside fastlane/, actions run from the repository root.
PUBSPEC = File.expand_path("../pubspec.yaml", __dir__)
PLAY_METADATA = "fastlane/metadata/android"
IOS_METADATA = "fastlane/metadata/ios"

def version_name
  name = File.read(PUBSPEC)[/^version:\s*([^+\s]+)/, 1]
  UI.user_error!("pubspec.yaml's version '#{name}' is not of the form 1.2.3") unless name.to_s.match?(/\A\d+\.\d+\.\d+\z/)
  name
end

def build_number(options)
  build = options[:build].to_s
  UI.user_error!("Pass build:<number>, the build number testers have (TestFlight and Play show it in brackets)") unless build.match?(/\A\d+\z/)
  build
end

# The promote and listing lanes authenticate with the key promote.yml writes to
# a file. The screenshot lanes keep their own setup.
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH")
  )
end

# Shared by the iOS promote and listing lanes.
def deliver_options
  {
    api_key: asc_api_key,
    platform: "ios",
    app_version: version_name,
    metadata_path: IOS_METADATA,
    skip_binary_upload: true,
    skip_screenshots: true,
    # No HTML preview to confirm: this runs unattended.
    force: true
  }
end

platform :android do
  desc "Promote a build from internal testing to production, with the listing and release notes"
  desc "Options: build:<number> (required), rollout:<percent> (default 100)"
  lane :promote do |options|
    rollout = (options[:rollout] || 100).to_f
    UI.user_error!("rollout must be a percentage above 0 and at most 100") unless rollout > 0 && rollout <= 100

    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      version_code: build_number(options).to_i,
      rollout: (rollout / 100).to_s,
      metadata_path: PLAY_METADATA,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload the store listing text only. It goes live once Google accepts it"
  lane :listing do
    upload_to_play_store(
      metadata_path: PLAY_METADATA,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Download the live listing into path:<dir>, to compare with the repository"
  lane :fetch_listing do |options|
    download_from_play_store(metadata_path: options[:path] || UI.user_error!("Pass path:<dir>"))
  end

  desc "Upload screenshots to Google Play Store"
  lane :upload_screenshots do
    # Get absolute paths
    fastlane_dir = File.expand_path("..", Dir.pwd)
    metadata_path = File.join(fastlane_dir, "fastlane", "metadata", "android")
    screenshots_source = File.join(fastlane_dir, "screenshots", "store", "android")

    UI.message("Fastlane directory: #{fastlane_dir}")
    UI.message("Metadata path: #{metadata_path}")
    UI.message("Screenshots source: #{screenshots_source}")

    # Create metadata structure for Play Store
    FileUtils.mkdir_p(File.join(metadata_path, "en-US", "images", "phoneScreenshots"))
    FileUtils.mkdir_p(File.join(metadata_path, "en-US", "images", "sevenInchScreenshots"))
    FileUtils.mkdir_p(File.join(metadata_path, "en-US", "images", "tenInchScreenshots"))

    # Copy screenshots from our store directory to Fastlane structure
    phone_screenshots = Dir.glob(File.join(screenshots_source, "phone", "*.png"))
    tablet7_screenshots = Dir.glob(File.join(screenshots_source, "tablet-7", "*.png"))
    tablet10_screenshots = Dir.glob(File.join(screenshots_source, "tablet-10", "*.png"))

    phone_screenshots.each { |f| FileUtils.cp(f, File.join(metadata_path, "en-US", "images", "phoneScreenshots")) }
    tablet7_screenshots.each { |f| FileUtils.cp(f, File.join(metadata_path, "en-US", "images", "sevenInchScreenshots")) }
    tablet10_screenshots.each { |f| FileUtils.cp(f, File.join(metadata_path, "en-US", "images", "tenInchScreenshots")) }

    UI.message("Copied #{phone_screenshots.length} phone screenshots")
    UI.message("Copied #{tablet7_screenshots.length} 7-inch tablet screenshots")
    UI.message("Copied #{tablet10_screenshots.length} 10-inch tablet screenshots")

    # Upload screenshots from screenshots/store/android/ to Play Store
    upload_to_play_store(
      json_key: ENV["SUPPLY_JSON_KEY"],
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: false,
      metadata_path: metadata_path,
      package_name: ENV["ANDROID_PACKAGE_NAME"] || "org.getspot"
    )

    UI.success("Screenshots uploaded to Google Play Store!")
  end

  desc "Prepare Maestro screenshots for Play Store"
  lane :prepare_screenshots do
    UI.message("Organizing screenshots from Maestro to Play Store format...")

    # Copy screenshots to Play Store expected locations
    # You can customize these paths based on your needs
    sh("mkdir -p ../screenshots/store/android/phone")
    sh("mkdir -p ../screenshots/store/android/tablet-7")
    sh("mkdir -p ../screenshots/store/android/tablet-10")

    UI.success("Screenshot directories prepared! Copy your Maestro screenshots to:")
    UI.message("  - screenshots/store/android/phone/")
    UI.message("  - screenshots/store/android/tablet-7/")
    UI.message("  - screenshots/store/android/tablet-10/")
  end
end

platform :ios do
  desc "Submit a TestFlight build for App Review with the listing and release notes"
  desc "It goes live automatically once Apple approves it. Options: build:<number> (required)"
  lane :promote do |options|
    deliver(
      deliver_options.merge(
        build_number: build_number(options),
        submit_for_review: true,
        automatic_release: true,
        # Apple's review is the check that matters, and precheck cannot read
        # in-app purchases with an API key anyway.
        run_precheck_before_submit: false,
        # Export compliance is answered by ITSAppUsesNonExemptEncryption in
        # ios/Runner/Info.plist.
        submission_information: {
          add_id_info_uses_idfa: false,
          content_rights_contains_third_party_content: false
        }
      )
    )
  end

  desc "Upload the listing to the version being prepared (pubspec's version), without submitting it"
  lane :listing do
    deliver(deliver_options)
  end

  desc "Upload screenshots to App Store Connect"
  lane :upload_screenshots do
    deliver(
      app_identifier: ENV["APP_IDENTIFIER"] || "org.getspot",
      skip_binary_upload: true,
      skip_metadata: true,
      skip_app_version_update: true,
      overwrite_screenshots: true,
      screenshots_path: "./screenshots/store/ios",
      force: true
    )

    UI.success("Screenshots uploaded to App Store Connect!")
  end

  desc "Prepare Maestro screenshots for App Store"
  lane :prepare_screenshots do
    UI.message("Organizing screenshots from Maestro to App Store format...")

    # Create directories for App Store required sizes
    sh("mkdir -p ../screenshots/store/ios/iphone-6.5")
    sh("mkdir -p ../screenshots/store/ios/ipad-12.9")

    UI.success("Screenshot directories prepared! Copy your Maestro screenshots to:")
    UI.message("  - screenshots/store/ios/iphone-6.5/")
    UI.message("  - screenshots/store/ios/ipad-12.9/")
  end
end
